{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(pnpm run deploy*)",
      "Bash(pnpm deploy*)",
      "Bash(npm run deploy*)",
      "Bash(node src/deploy.js*)",
      "Bash(node ./src/deploy.js*)",
      "Bash(pnpm run prune*)",
      "Bash(pnpm prune*)",
      "Bash(npm run prune*)",
      "Bash(node src/pruneGuildData.js*)",
      "Bash(node ./src/pruneGuildData.js*)",
      "Bash(ssh*)",
      "Bash(scp*)",
      "Bash(wrangler*)",
      "Bash(npx wrangler*)",
      "Bash(pnpm wrangler*)",
      "Bash(pnpm exec wrangler*)",
      "Bash(pnpm dlx wrangler*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Bash(pnpm dlx vercel*)",
      "Read(./.env*)",
      "Read(**/.env*)",
      "Read(**/*.log)",
      "Read(**/logs/**)",
      "Read(**/.pm2/**)"
    ]
  }
}
