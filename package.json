{
  "name": "biblicana",
  "version": "1.6.1",
  "description": "Discord bot for scripture lookups, commentary, cross-references, prophecies, and more.",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@sentry/node": "^11.0.0",
    "@sentry/profiling-node": "^11.0.0",
    "axios": "^1.15.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "joi": "^18.1.2",
    "loglevel": "^1.9.2",
    "pg": "^8.13.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "yaml": "^2.9.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "lefthook": "^2.1.15"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node --import ./src/instrument.js src/index.js",
    "lint": "pnpm exec eslint .",
    "verify": "pnpm run lint && pnpm test",
    "prepare": "lefthook install || echo 'WARNING: lefthook install failed, git hooks are NOT installed. Run: pnpm exec lefthook install' >&2",
    "prune": "node src/pruneGuildData.js",
    "deploy": "node src/deploy.js",
    "deployg": "node src/deploy.js --global",
    "legal:publish": "node src/publishLegal.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  },
  "author": "BlueBerean",
  "license": "ISC"
}
